{
  "name": "capsule-manager",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "concurrently \"vite src\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "vite build && electron-builder"
  },
  "build": {
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": [
        "AppImage",
        "snap"
      ]
    }
  },
  "dependencies": {
    "axios": "^1.7.0",
    "crypto-js": "^4.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^8.0.0",
    "electron": "^30.0.0",
    "electron-builder": "^24.0.0",
    "vite": "^5.4.0",
    "wait-on": "^7.0.0"
  }
}
