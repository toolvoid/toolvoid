{
  "name": "capsule-manager",
  "version": "1.0.0",
  "description": "Capsule Manager desktop app",
  "author": {
    "name": "toolvoid",
    "email": "0voidtool0@gmail.com"
  },
  "homepage": "https://github.com/toolvoid/toolvoid",
  "main": "main.js",
  "scripts": {
    "start": "concurrently \"vite src\" \"wait-on http://localhost:5173 && electron .\"",
    "build:renderer": "vite build",
    "build": "npm run build:renderer && electron-builder"
  },
  "build": {
    "files": [
      "dist/**/*",
      "core/**/*",
      "bridge/**/*",
      "main.js",
      "preload.js",
      "capsule-schema.json"
    ],
    "extraMetadata": {
      "main": "main.js"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": [
        "deb",
        "rpm",
        "AppImage"
      ],
      "category": "Utility",
      "maintainer": "toolvoid <0voidtool0@gmail.com>",
      "desktop": {
        "StartupNotify": "true"
      }
    }
  },
  "dependencies": {
    "axios": "^1.7.0",
    "crypto-js": "^4.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^8.0.0",
    "electron": "^30.0.0",
    "electron-builder": "^24.0.0",
    "vite": "^5.4.0",
    "wait-on": "^7.0.0"
  }
}
